generator client {
  provider = "prisma-client-js"
  previewFeatures = ["omitApi"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model user_accounts {
  id                          String      @id @default(uuid())
  username                    String      @unique()
  password                    String
  expired                     Boolean     @default(false)
  expire_at                   DateTime?
  expireInterval              Int         @default(30)
  mustchangepassword          Boolean     @default(false)
  firstname                   String
  lastname                    String
  description                 String
  concurrent                  Int         @default(1)
  isActive                    Boolean     @default(true)
  isSuperAdmin                Boolean     @default(false)
  isHidden                    Boolean     @default(false)
  created_at                  DateTime    @default(now())
  updated_at                  DateTime    @updatedAt()
  camera                      camera[]
  user_groups                 user_groups[]
  user_roles                  user_roles[]
  user_tokens                 user_tokens[]
  camera_groups               camera_groups[]
  scheduler_user_account      scheduler_user_account[]
}

model user_groups {
  id                          String      @id @default(uuid())
  name                        String      @unique()
  created_at                  DateTime    @default(now())
  updated_at                  DateTime    @updatedAt()
  user_accounts               user_accounts[]
  user_roles                  user_roles[]
  camera                      camera[]
  camera_groups               camera_groups[]
}

model user_roles {
  id                          String      @id @default(uuid())
  name                        String      @unique()
  description                 String
  default                     Boolean     @default(true)
  created_at                  DateTime    @default(now())
  updated_at                  DateTime    @updatedAt()
  user_accounts               user_accounts[]
  user_groups                 user_groups[]
}

model user_tokens {
  id                          String        @id @default(uuid())
  token                       String
  expiration                  DateTime
  service                     String        @default("") // web / client
  ip                          String        @default("")
  created_at                  DateTime      @default(now())
  updated_at                  DateTime      @updatedAt()
  user_accounts               user_accounts[]
}

model camera {
  id                          String      @id @default(uuid())
  url                         String      @unique()
  username                    String
  password                    String
  status                      String      @default("ok")
  created_at                  DateTime    @default(now())
  updated_at                  DateTime    @updatedAt()
  camera_info                 camera_info[]
  camera_service_camera       camera_service_camera[]
  camera_recorder_camera      camera_recorder_camera[]
  user_accounts               user_accounts[]
  camera_groups               camera_groups[]
  user_groups                 user_groups[]
}

model camera_groups {
  id                          String      @id @default(uuid())
  name                        String      @unique()
  created_at                  DateTime    @default(now())
  updated_at                  DateTime    @updatedAt()
  camera                      camera[]
  user_accounts               user_accounts[]
  user_groups                 user_groups[]
}

model camera_info {
  id                          String        @id @default(uuid())
  key                         String
  value                       String
  camera                      camera[]
}

model camera_service {
  id                          String        @id @default(uuid())
  url                         String        @unique()
  port                        String
  port_from                   String
  port_to                     String
  created_at                  DateTime    @default(now())
  updated_at                  DateTime    @updatedAt()
  camera_service_camera       camera_service_camera[]
}

model camera_service_camera {
  id                          String        @id @default(uuid())
  type                        String
  port                        Int
  status                      Boolean
  state                       String @default("none")
  camera_service              camera_service[]
  camera                      camera[]
}

model camera_recorder {
  id                          String        @id @default(uuid())
  url                         String        @unique()
  port                        String
  created_at                  DateTime    @default(now())
  updated_at                  DateTime    @updatedAt()
  camera_recorder_camera       camera_recorder_camera[]
}

model camera_recorder_camera {
  id                          String        @id @default(uuid())
  status                      String @default("none")
  session                     String @default("none")
  camera_recorder             camera_recorder[]
  camera                      camera[]
}

model camera_playback {
  id                          String        @id @default(uuid())
  url                         String        @unique()
  port                        String
  created_at                  DateTime    @default(now())
  updated_at                  DateTime    @updatedAt()
}

model setting_password_complexity {
  id                          String @id @default("main")
  minimumCharactersCount      Int @default(8)
  haveSpecialCharacters       Boolean @default(true)
  haveUppercaseCharacters     Boolean @default(true)
  haveLowercaseCharacters     Boolean @default(true)
  haveDigits                  Boolean @default(true)
}

model logger_logs {
  id                          String      @id @default(uuid())
  log                         String
  level                       Int @default(0) // 0 info - 1 notify - 2 important
  by                          String? // executor of command
  user                        String?
  user_group                  String?
  camera                      String?
  camera_group                String?
  created_at                  DateTime    @default(now())
}

model scheduler_user_account {
  id                          String      @id @default(uuid())
  title                       String
  from                        String
  to                          String
  created_at                  DateTime    @default(now())
  user_accounts               user_accounts[]
}
