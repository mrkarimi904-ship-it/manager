generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model user_accounts {
  id                          String      @id @default(uuid())
  username                    String      @unique()
  password                    String
  expired                     Boolean     @default(false)
  expire_at                   DateTime?
  expireInterval              Int         @default(30)
  mustchangepassword          Boolean     @default(false)
  firstname                   String
  lastname                    String
  description                 String
  isActive                    Boolean     @default(true)
  isSuperAdmin                Boolean     @default(false)
  isHidden                    Boolean     @default(false)
  created_at                  DateTime    @default(now())
  updated_at                  DateTime    @updatedAt()
  camera                      camera[]
  user_groups                 user_groups[]
  user_roles                  user_roles[]
  user_tokens                 user_tokens[]
  camera_groups               camera_groups[]
  logger_notifications        logger_notifications[]
}

model user_groups {
  id                          String      @id @default(uuid())
  name                        String      @unique()
  created_at                  DateTime    @default(now())
  updated_at                  DateTime    @updatedAt()
  user_accounts               user_accounts[]
  user_roles                  user_roles[]
  camera                      camera[]
  camera_groups               camera_groups[]
}

model user_roles {
  id                          String      @id @default(uuid())
  name                        String      @unique()
  description                 String
  default                     Boolean     @default(true)
  created_at                  DateTime    @default(now())
  updated_at                  DateTime    @updatedAt()
  user_accounts               user_accounts[]
  user_groups                 user_groups[]
}

model user_tokens {
  id                          String        @id @default(uuid())
  token                       String
  expiration                  DateTime
  created_at                  DateTime      @default(now())
  updated_at                  DateTime      @updatedAt()
  user_accounts               user_accounts[]
}

model camera {
  id                          String      @id @default(uuid())
  url                         String      @unique()
  username                    String
  password                    String
  created_at                  DateTime    @default(now())
  updated_at                  DateTime    @updatedAt()
  camera_info                 camera_info[]
  camera_service_camera       camera_service_camera[]
  camera_recorder_camera      camera_recorder_camera[]
  user_accounts               user_accounts[]
  camera_groups               camera_groups[]
  user_groups                 user_groups[]
}

model camera_groups {
  id                          String      @id @default(uuid())
  name                        String      @unique()
  created_at                  DateTime    @default(now())
  updated_at                  DateTime    @updatedAt()
  camera                      camera[]
  user_accounts               user_accounts[]
  user_groups                 user_groups[]
}

model camera_info {
  id                          String        @id @default(uuid())
  camera_id                   String
  key                         String
  value                       String
  camera                      camera @relation(fields: [camera_id], references: [id])
}

model camera_service {
  id                          String        @id @default(uuid())
  url                         String        @unique()
  port                        String
  port_from                   String
  port_to                     String
  created_at                  DateTime    @default(now())
  updated_at                  DateTime    @updatedAt()
  camera_service_camera       camera_service_camera[]
}

model camera_service_camera {
  id                          String        @id @default(uuid())
  camera_service_id           String
  camera_id                   String
  type                        String
  port                        Int
  status                      Boolean
  state                       String @default("none")
  camera_service              camera_service @relation(fields: [camera_service_id], references: [id])
  camera                      camera @relation(fields: [camera_id], references: [id])
}

model camera_recorder {
  id                          String        @id @default(uuid())
  url                         String        @unique()
  port                        String
  created_at                  DateTime    @default(now())
  updated_at                  DateTime    @updatedAt()
  camera_recorder_camera       camera_recorder_camera[]
}

model camera_recorder_camera {
  id                          String        @id @default(uuid())
  camera_recorder_id          String
  camera_id                   String
  status                      Boolean
  state                       String @default("none")
  camera_recorder             camera_recorder @relation(fields: [camera_recorder_id], references: [id])
  camera                      camera @relation(fields: [camera_id], references: [id])
}

model camera_playback {
  id                          String        @id @default(uuid())
  url                         String        @unique()
  port                        String
  created_at                  DateTime    @default(now())
  updated_at                  DateTime    @updatedAt()
}

model setting_password_complexity {
  id                          String @id @default("main")
  minimumCharactersCount      Int @default(8)
  haveSpecialCharacters       Boolean @default(true)
  haveUppercaseCharacters     Boolean @default(true)
  haveLowercaseCharacters     Boolean @default(true)
  haveDigits                  Boolean @default(true)
}









model logger_logs {
  id                          String      @id @default(uuid())
  log                         String
  internal                    Boolean     @default(false)
  by                          String?
  user                        String?
  user_group                  String?
  camera                      String?
  camera_group                String?
  created_at                  DateTime    @default(now())
}

model logger_notifications {
  id                          String      @id @default(uuid())
  title                       String
  content                     String
  type                        String      @default("Info")
  created_at                  DateTime    @default(now())
  user_accounts               user_accounts[]
}
