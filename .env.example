DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vms?schema=public"
ONVIF_SERVICE="http://localhost:3001"
SNAPSHOT_SERVICE="http://localhost:3006"
JWT_SECRET="8A29D7EFFF21574F47E6A936CB7B6"
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD="lprlpr"
MINIO_ENABLE=true
MINIO_URL=http://localhost:9000  # or https://minio.example.com
MINIO_BUCKET=lpr
MINIO_ACCESS=lpraccesskey
MINIO_SECRET=lprsecretkey

# ── Backup/Restore — disk space monitoring paths ──
POSTGRES_DATA_PATH=/var/lib/postgresql/data
MINIO_DATA_PATH=/data

# ── Backup/Restore — disk space thresholds (percent free) ──
DISK_SPACE_START_ARCHIVE_PERCENT=20
DISK_SPACE_STOP_ARCHIVE_PERCENT=30
DISK_SPACE_CRITICAL_PERCENT=5

# ── Backup/Restore — LPR backup config ──
LPR_BACKUP_BATCH_SIZE=1000
LPR_BACKUP_MIN_AGE_DAYS=7

# ── Backup/Restore — logger backup config ──
LOGGER_BACKUP_KEEP_COUNT=100000
LOGGER_BACKUP_BATCH_SIZE=50000

# ── Backup/Restore — backup destination (s3 | local) ──
ROTATION_BACKUP_TYPE=local
ROTATION_BACKUP_LOCAL_PATH=/mnt/backup-storage/lpr-archives

# S3 backup destination (used when ROTATION_BACKUP_TYPE=s3)
ROTATION_BACKUP_S3_ENDPOINT=https://backup.example.com
ROTATION_BACKUP_S3_BUCKET=lpr-backups
ROTATION_BACKUP_S3_ACCESS_KEY=backupaccesskey
ROTATION_BACKUP_S3_SECRET_KEY=backupsecretkey
ROTATION_BACKUP_S3_REGION=us-east-1
ROTATION_BACKUP_S3_USE_SSL=true